{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pktito",
  "version": "0.9.2",
  "identifier": "net.pktito.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pktito",
        "width": 680,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "create": false,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/audio/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Speech to text on this computer",
    "longDescription": "Transcribes audio and video on your computer, with nothing uploaded. Built on NVIDIA's Parakeet-TDT speech models.",
    "copyright": "Peter Hebert, MIT license. Models: NVIDIA, CC-BY-4.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/fonts/Archivo-OFL.txt": "licenses/Archivo-OFL.txt",
      "../ui/fonts/CommitMono-OFL.txt": "licenses/CommitMono-OFL.txt",
      "../vendor/pktito/LICENSE": "licenses/pktito-LICENSE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
