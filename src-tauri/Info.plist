<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged over the Info.plist Tauri writes. pktito's model files, .pkf, as
     a type of their own, with their icon (icons/model.icns,
     scripts/model-icon.py), which Finder shows once the app is on the Mac.
     One double-clicked opens the app, which uses it as its model (main.rs,
     hand_over and use_file): a viewer of them, so not their editor. -->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.pktito.model</string>
			<key>UTTypeDescription</key>
			<string>pktito model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeIconFile</key>
			<string>model.icns</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pkf</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>pktito model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.pktito.model</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>model.icns</string>
		</dict>
	</array>
</dict>
</plist>
