{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "linux": {
      "deb": {
        "depends": ["ffmpeg"],
        "recommends": ["xdg-utils"],
        "desktopTemplate": "linux/pktito.desktop",
        "files": {
          "/usr/share/mime/packages/pktito.xml": "linux/pktito-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/application-x-pktito-model.png": "icons/model/16x16.png",
          "/usr/share/icons/hicolor/24x24/mimetypes/application-x-pktito-model.png": "icons/model/24x24.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-pktito-model.png": "icons/model/32x32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-pktito-model.png": "icons/model/48x48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-pktito-model.png": "icons/model/64x64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-pktito-model.png": "icons/model/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-pktito-model.png": "icons/model/256x256.png"
        }
      }
    }
  }
}
