# Tauri's desktop file (tauri-bundler's main.desktop) with %F, so that a
# file opened with the app reaches it, and pktito's model files as a type it
# opens (linux/pktito-mime.xml, tauri.linux.conf.json)
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=application/x-pktito-model;
