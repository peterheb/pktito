    <!-- Privacy (privacy.*), as Android has it: a device, the system's
         pickers, the app's data deleted with it; site/build.py's policy
         says the same -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">pktito is local transcription software — it turns speech into text on this device. Your media files are not uploaded to cloud servers, and pktito has no accounts, ads or tracking.</string>
    <string name="privacy_internet">What reaches the internet</string>
    <string name="privacy_download"><![CDATA[<b>Downloading a model.</b> pktito downloads AI models from models.pktito.net, hosted on a content delivery network. The server logs your IP address, the time, the file requested and a standard user-agent string, but no name, account or device identifier. These logs are used to keep the service secure and to count downloads in aggregate. We don\'t use them to identify you, combine them with other data, or sell or share them.]]></string>
    <string name="privacy_links"><![CDATA[<b>Links.</b> Links in pktito open in your browser, and each site\'s own privacy policy applies there.]]></string>
    <string name="privacy_files">Your files</string>
    <string name="privacy_files_text">pktito opens only the recordings you choose, open with it or share to it, and saves only where you choose. It asks for no access to your storage. A transcript you share goes to the app you pick.</string>
    <string name="privacy_choices">Your choices</string>
    <string name="privacy_choice_file">To skip the download, use a model file you already have: choose “Open a model file…”.</string>
    <string name="privacy_choice_uninstall">pktito keeps its settings, its models and its recent transcripts out of Android\'s backups; uninstalling it deletes them.</string>
    <string name="privacy_questions">Questions</string>
    <string name="privacy_ask"><![CDATA[Ask by email, at <a href="mailto:peter.hebert@pktito.net">peter.hebert@pktito.net</a>, or on <a href="https://github.com/peterheb/pktito/issues">GitHub</a>. The full policy is at <a href="https://pktito.net/privacy">pktito.net/privacy</a>.]]></string>
    <string name="privacy_updated">Last updated October 26, 2026</string>
