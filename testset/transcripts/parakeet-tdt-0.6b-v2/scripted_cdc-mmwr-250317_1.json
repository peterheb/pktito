  "captions": [
    {"start": 0.145, "end": 4.865, "lines": ["During the week of March 17th,","MMWR published reports on TB management"]},
    {"start": 4.865, "end": 6.465, "lines": ["in Uganda, experiences"]},
    {"start": 6.465, "end": 11.185, "lines": ["of violence among adolescent girls","and young women in Eswatini, and more."]},
    {"start": 11.185, "end": 14.705, "lines": ["Let's take a look at headlines","from the week of March 17th."]},
    {"start": 14.705, "end": 18.865, "lines": ["First, a pilot study in Uganda increases","screening and treatment for members"]},
    {"start": 18.865, "end": 23.376, "lines": ["of households affected by tuberculosis,","helping to reduce transmission."]},
    {"start": 23.376, "end": 24.976, "lines": ["Second, adolescent girls"]},
    {"start": 24.976, "end": 28.176, "lines": ["and young women in Eswatini","who have functional disabilities"]},
    {"start": 28.176, "end": 32.896, "lines": ["are more likely to experience sexual,","physical, and emotional violence."]},
    {"start": 32.896, "end": 36.896, "lines": ["Last, a U.S. traveler returning","from Zimbabwe was hospitalized"]},
    {"start": 36.896, "end": 40.656, "lines": ["with a rare parasite infection","that causes sleeping sickness."]},
    {"start": 40.656, "end": 44.176, "lines": ["Welcome, I'm Mary Dott,","science editor of CDC's Morbidity"]},
    {"start": 44.176, "end": 46.256, "lines": ["and Mortality Weekly Report."]},
    {"start": 46.256, "end": 48.816, "lines": ["Thanks for joining me","for MMWR's weekly briefing"]},
    {"start": 48.816, "end": 51.92, "lines": ["for reports published the week","of March 17th."]},
    {"start": 51.92, "end": 55.92, "lines": ["Tuberculosis, or TB,","is a disease caused by germs spread"]},
    {"start": 55.92, "end": 58.16, "lines": ["from person to person through the air."]},
    {"start": 58.16, "end": 60.24, "lines": ["People who live with someone who has TB"]},
    {"start": 60.24, "end": 63.6, "lines": ["are at increased risk","of infection and disease."]},
    {"start": 63.6, "end": 68.4, "lines": ["However, worldwide, only about 21%","of those household members receive"]},
    {"start": 68.4, "end": 71.28, "lines": ["TB preventive treatment in 2023."]},
    {"start": 71.28, "end": 74.56, "lines": ["In our first report,","Case Finding Among and Comprehensive"]},
    {"start": 74.56, "end": 78.624, "lines": ["Management of Household Contacts","of Persons with Pulmonary Tuberculosis."]},
    {"start": 78.624, "end": 82.704, "lines": ["CDC and partners in Uganda","piloted a comprehensive approach"]},
    {"start": 82.704, "end": 87.184, "lines": ["to identify more household TB exposures","and provide preventive treatment."]},
    {"start": 87.184, "end": 91.424, "lines": ["The comprehensive approach included home","visits for screening for TB symptoms,"]},
    {"start": 91.424, "end": 94.464, "lines": ["free chest x-rays,","short course preventive treatment,"]},
    {"start": 94.464, "end": 96.144, "lines": ["and follow-up counseling."]},
    {"start": 96.144, "end": 101.984, "lines": ["Between November 2023 and September 2024,","the program screened 91%"]},
    {"start": 101.984, "end": 106, "lines": ["of nearly 2,000 household members","of known TB patients."]},
    {"start": 106, "end": 110.48, "lines": ["Of those screened, 80 household","contacts were diagnosed with TB."]},
    {"start": 110.48, "end": 112.08, "lines": ["More than 1,200 people started"]},
    {"start": 112.08, "end": 116.48, "lines": ["tuberculosis preventive treatment,","and about 95% completed it."]},
    {"start": 116.48, "end": 118.32, "lines": ["This approach serves as a model"]},
    {"start": 118.32, "end": 120.72, "lines": ["for expanding household interventions","in areas"]},
    {"start": 120.72, "end": 125.44, "lines": ["with high rates of TB. Other countries","can use this example to increase screening"]},
    {"start": 125.44, "end": 129.6, "lines": ["and treatment efforts among households","affected by TB. These efforts"]},
    {"start": 129.6, "end": 133.712, "lines": ["are needed to reduce the spread","of disease and ultimately eliminate it."]},
    {"start": 133.712, "end": 138.032, "lines": ["Eswatini, a country in southern Africa,","has made substantial progress"]},
    {"start": 138.032, "end": 142.752, "lines": ["in responding to the HIV epidemic","and reducing violence against children."]},
    {"start": 142.752, "end": 144.912, "lines": ["However, adolescent girls and young women"]},
    {"start": 144.912, "end": 149.392, "lines": ["with disabilities may be at increased","risk for violence and HIV."]},
    {"start": 149.392, "end": 152.672, "lines": ["In our second report,","Functional Disability, Violence,"]},
    {"start": 152.672, "end": 157.552, "lines": ["HIV Status, and Risk Factors for HIV","Among Adolescent Girls and Young Women,"]},
    {"start": 157.552, "end": 162.272, "lines": ["CDC, the Government of Eswatini,","and partner organizations analyzed data"]},
    {"start": 162.272, "end": 166.832, "lines": ["from more than 6,300 adolescent girls","and young women who participated"]},
    {"start": 166.832, "end": 170.192, "lines": ["in the 2022 Eswatini","Violence Against Children"]},
    {"start": 170.192, "end": 173.872, "lines": ["and Youth Survey. This was done","to understand how common functional"]},
    {"start": 173.872, "end": 177.232, "lines": ["disabilities are and their relationship","to HIV infection"]},
    {"start": 177.232, "end": 179.472, "lines": ["and experiencing violence."]},
    {"start": 179.472, "end": 182.672, "lines": ["Data showed that about one","in seven or fourteen percent"]},
    {"start": 182.672, "end": 187.392, "lines": ["of adolescent girls and young women","in Eswatini ages thirteen to twenty four"]},
    {"start": 187.392, "end": 189.616, "lines": ["reported having a functional disability."]},
    {"start": 189.616, "end": 193.244, "lines": ["such as difficulty seeing,","walking, or communicating."]}
  ]
}
