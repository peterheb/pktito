      {"start": 154, "end": 154.32, "text": "found"},
      {"start": 154.32, "end": 154.56, "text": "this"},
      {"start": 154.56, "end": 154.88, "text": "new"},
      {"start": 154.88, "end": 155.36, "text": "bug"},
