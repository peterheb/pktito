      {"start": 207.456, "end": 207.536, "text": "you"},
      {"start": 207.536, "end": 207.696, "text": "put"},
      {"start": 207.696, "end": 207.776, "text": "a"},
      {"start": 207.776, "end": 208.176, "text": "cream"},
      {"start": 208.176, "end": 208.256, "text": "on"},
      {"start": 208.256, "end": 208.416, "text": "it"},
