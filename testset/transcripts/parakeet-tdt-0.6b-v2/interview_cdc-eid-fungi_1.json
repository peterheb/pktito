      {"start": 122.64, "end": 122.88, "text": "the"},
      {"start": 122.88, "end": 123.28, "text": "reason"},
      {"start": 123.28, "end": 123.52, "text": "is"},
      {"start": 123.76, "end": 124.64, "text": "fungi"},
      {"start": 124.64, "end": 124.96, "text": "are"},
      {"start": 124.96, "end": 125.28, "text": "so"},
      {"start": 125.28, "end": 126.24, "text": "similar"},
      {"start": 126.24, "end": 126.56, "text": "to"},
      {"start": 126.56, "end": 126.8, "text": "us"},
      {"start": 127.04, "end": 127.36, "text": "that"},
      {"start": 127.36, "end": 127.92, "text": "anything"},
      {"start": 127.92, "end": 128.24, "text": "that"},
      {"start": 128.24, "end": 128.56, "text": "we"},
      {"start": 128.56, "end": 128.8, "text": "use"},
      {"start": 128.8, "end": 129.12, "text": "to"},
      {"start": 129.12, "end": 129.84, "text": "target"},
      {"start": 129.84, "end": 130.8, "text": "fungi"},
      {"start": 131.12, "end": 131.76, "text": "usually"},
      {"start": 131.76, "end": 132, "text": "has"},
      {"start": 132, "end": 132.48, "text": "side"},
      {"start": 132.48, "end": 133.12, "text": "effects"},
      {"start": 133.12, "end": 133.36, "text": "for"},
      {"start": 133.36, "end": 134, "text": "us."}
    ]},
    {"start": 134, "end": 141.04, "text": "So we haven't been able to develop a whole lot of drugs against fungi the way we have against bacteria.", "words": [
      {"start": 134, "end": 134.08, "text": "So"},
      {"start": 134.16, "end": 134.4, "text": "we"},
      {"start": 134.4, "end": 134.8, "text": "haven't"},
