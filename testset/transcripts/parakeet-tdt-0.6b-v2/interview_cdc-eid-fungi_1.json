      {"start": 168.656, "end": 168.976, "text": "never"},
      {"start": 168.976, "end": 169.216, "text": "had"},
      {"start": 169.216, "end": 169.616, "text": "spread"},
      {"start": 169.616, "end": 169.776, "text": "like"},
      {"start": 169.776, "end": 170.176, "text": "this."}
    ]},
    {"start": 170.176, "end": 173.616, "text": "And we've seen it in plant pathogens for sure.", "words": [
