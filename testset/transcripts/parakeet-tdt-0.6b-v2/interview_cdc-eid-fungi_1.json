      {"start": 180.576, "end": 180.736, "text": "over"},
      {"start": 180.736, "end": 180.976, "text": "from"},
      {"start": 180.976, "end": 181.776, "text": "Asia."}
    ]},
    {"start": 181.776, "end": 184.096, "text": "But we've never seen it in humans.", "words": [
      {"start": 181.776, "end": 181.936, "text": "But"},
      {"start": 181.936, "end": 182.256, "text": "we've"},
      {"start": 182.256, "end": 182.496, "text": "never"},
