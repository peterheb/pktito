      {"start": 173.136, "end": 173.296, "text": "for"},
      {"start": 173.296, "end": 173.616, "text": "sure."}
    ]},
    {"start": 173.616, "end": 178.336, "text": "You know, the chestnut trees, a billion chestnut trees in the U.S.", "words": [
