      {"start": 136.16, "end": 136.64, "text": "whole"},
      {"start": 136.64, "end": 136.8, "text": "lot"},
      {"start": 136.8, "end": 137.04, "text": "of"},
      {"start": 137.04, "end": 137.76, "text": "drugs"},
      {"start": 137.76, "end": 138.32, "text": "against"},
      {"start": 138.32, "end": 139.2, "text": "fungi"},
      {"start": 139.2, "end": 139.44, "text": "the"},
      {"start": 139.44, "end": 139.6, "text": "way"},
      {"start": 139.6, "end": 139.76, "text": "we"},
      {"start": 139.76, "end": 140, "text": "have"},
      {"start": 140, "end": 140.32, "text": "against"},
      {"start": 140.32, "end": 141.04, "text": "bacteria."}
    ]},
    {"start": 141.04, "end": 143.52, "text": "Bacteria are very different from us.", "words": [
      {"start": 141.04, "end": 141.84, "text": "Bacteria"},
      {"start": 141.84, "end": 142.16, "text": "are"},
      {"start": 142.16, "end": 142.48, "text": "very"},
      {"start": 142.48, "end": 142.8, "text": "different"},
      {"start": 142.8, "end": 143.04, "text": "from"},
      {"start": 143.04, "end": 143.52, "text": "us."}
    ]},
    {"start": 143.6, "end": 144.4, "text": "Fungi aren't.", "words": [
      {"start": 143.6, "end": 144.16, "text": "Fungi"},
      {"start": 144.16, "end": 144.4, "text": "aren't."}
    ]},
    {"start": 144.4, "end": 145.44, "text": "They're eukaryotes.", "words": [
      {"start": 144.4, "end": 144.56, "text": "They're"},
      {"start": 144.56, "end": 145.44, "text": "eukaryotes."}
    ]},
    {"start": 145.44, "end": 147.84, "text": "They have the same machinery, as I said.", "words": [
      {"start": 145.44, "end": 145.6, "text": "They"},
      {"start": 145.6, "end": 145.68, "text": "have"},
      {"start": 145.68, "end": 145.84, "text": "the"},
