      {"start": 173.696, "end": 173.936, "text": "know,"},
      {"start": 174.176, "end": 174.416, "text": "the"},
      {"start": 174.416, "end": 175.136, "text": "chestnut"},
      {"start": 175.136, "end": 175.776, "text": "trees,"},
      {"start": 175.776, "end": 176.016, "text": "a"},
      {"start": 176.016, "end": 176.496, "text": "billion"},
      {"start": 176.496, "end": 177.136, "text": "chestnut"},
      {"start": 177.136, "end": 177.536, "text": "trees"},
      {"start": 177.536, "end": 177.696, "text": "in"},
      {"start": 177.696, "end": 177.776, "text": "the"},
