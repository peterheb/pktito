      {"start": 162, "end": 162.24, "text": "time"},
      {"start": 162.24, "end": 162.48, "text": "we've"},
      {"start": 162.48, "end": 162.72, "text": "ever"},
      {"start": 162.72, "end": 162.88, "text": "had"},
      {"start": 162.88, "end": 163.04, "text": "a"},
      {"start": 163.04, "end": 163.44, "text": "human"},
