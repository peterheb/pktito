      {"start": 157.84, "end": 158.72, "text": "three."}
    ]},
    {"start": 158.72, "end": 160.72, "text": "It's really, really scary.", "words": [
      {"start": 158.72, "end": 159.12, "text": "It's"},
      {"start": 159.12, "end": 159.44, "text": "really,"},
      {"start": 159.44, "end": 159.76, "text": "really"},
