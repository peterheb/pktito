      {"start": 157.904, "end": 158.224, "text": "to"},
      {"start": 158.224, "end": 158.784, "text": "contribute"},
      {"start": 158.784, "end": 158.944, "text": "to"},
      {"start": 158.944, "end": 159.104, "text": "the"},
      {"start": 159.104, "end": 159.584, "text": "overall"},
      {"start": 159.584, "end": 160.624, "text": "plausibility"},
      {"start": 160.624, "end": 160.864, "text": "of"},
      {"start": 160.864, "end": 161.024, "text": "a"},
      {"start": 161.024, "end": 161.584, "text": "complaint."}
