      {"start": 141.024, "end": 141.264, "text": "and"},
      {"start": 141.264, "end": 141.504, "text": "there"},
      {"start": 141.504, "end": 141.744, "text": "is"},
      {"start": 141.744, "end": 142.064, "text": "no"},
      {"start": 142.064, "end": 142.304, "text": "one"},
      {"start": 142.304, "end": 143.024, "text": "specific"},
      {"start": 143.024, "end": 143.504, "text": "fund"},
      {"start": 143.504, "end": 143.744, "text": "that"},
