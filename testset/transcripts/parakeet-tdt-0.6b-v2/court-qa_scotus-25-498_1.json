      {"start": 185.248, "end": 185.568, "text": "court."}
    ]},
    {"start": 186.048, "end": 188.608, "text": "Is asking how the performance allegations contribute to the market.", "words": [
      {"start": 186.048, "end": 186.288, "text": "Is"},
      {"start": 186.288, "end": 186.688, "text": "asking"},
      {"start": 186.688, "end": 186.928, "text": "how"},
      {"start": 186.928, "end": 187.088, "text": "the"},
      {"start": 187.088, "end": 187.568, "text": "performance"},
