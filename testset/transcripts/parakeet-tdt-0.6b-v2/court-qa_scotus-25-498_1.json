    ]},
    {"start": 12.721, "end": 16.161, "text": "ERISA's duty of prudence is inherently flexible.", "words": [
      {"start": 12.721, "end": 13.521, "text": "ERISA's"},
      {"start": 13.521, "end": 13.761, "text": "duty"},
