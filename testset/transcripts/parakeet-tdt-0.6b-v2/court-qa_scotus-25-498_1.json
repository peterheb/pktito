      {"start": 193.648, "end": 193.888, "text": "have"},
      {"start": 193.888, "end": 194.128, "text": "a"},
      {"start": 194.128, "end": 194.848, "text": "fund,"},
      {"start": 194.848, "end": 195.088, "text": "an"},
      {"start": 195.088, "end": 195.808, "text": "equity"},
      {"start": 195.808, "end": 196.528, "text": "fund,"},
      {"start": 196.528, "end": 196.768, "text": "that"},
      {"start": 196.768, "end": 197.008, "text": "is"},
      {"start": 197.008, "end": 197.648, "text": "designed"},
      {"start": 197.648, "end": 197.968, "text": "to"},
      {"start": 197.968, "end": 198.688, "text": "produce"},
      {"start": 199.008, "end": 199.328, "text": "high"},
      {"start": 199.328, "end": 199.968, "text": "returns"},
      {"start": 200.048, "end": 200.288, "text": "but"},
