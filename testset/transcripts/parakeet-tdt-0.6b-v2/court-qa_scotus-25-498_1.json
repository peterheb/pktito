      {"start": 143.904, "end": 144.384, "text": "complaint"},
      {"start": 144.384, "end": 144.624, "text": "needs"},
      {"start": 144.624, "end": 144.864, "text": "to"},
      {"start": 144.864, "end": 145.504, "text": "identify"},
      {"start": 145.504, "end": 145.744, "text": "to"},
      {"start": 145.744, "end": 145.984, "text": "make"},
      {"start": 145.984, "end": 146.544, "text": "performance"},
      {"start": 146.544, "end": 147.264, "text": "allegations"},
      {"start": 147.264, "end": 148.304, "text": "relevant"},
      {"start": 148.624, "end": 148.864, "text": "to"},
      {"start": 148.864, "end": 149.264, "text": "support"},
      {"start": 149.264, "end": 149.504, "text": "a"},
      {"start": 149.504, "end": 149.904, "text": "claim"},
      {"start": 149.904, "end": 150.144, "text": "of"},
      {"start": 150.144, "end": 151.264, "text": "imprudence."}
    ]},
    {"start": 151.264, "end": 161.584, "text": "It can run a very wide spectrum of different ways that the complaint could use performance allegations to contribute to the overall plausibility of a complaint.", "words": [
      {"start": 151.264, "end": 151.504, "text": "It"},
      {"start": 151.504, "end": 151.744, "text": "can"},
