    {"start": 124.336, "end": 133.536, "text": "So are you saying that you can prove imprudence or demonstrate it by comparing dissimilar funds?", "words": [
      {"start": 124.336, "end": 124.576, "text": "So"},
      {"start": 125.136, "end": 125.456, "text": "are"},
      {"start": 125.456, "end": 125.776, "text": "you"},
      {"start": 126.096, "end": 126.416, "text": "saying"},
      {"start": 126.416, "end": 126.736, "text": "that"},
      {"start": 126.736, "end": 127.056, "text": "you"},
      {"start": 127.056, "end": 127.296, "text": "can"},
      {"start": 127.616, "end": 128.096, "text": "prove"},
      {"start": 128.096, "end": 129.056, "text": "imprudence"},
      {"start": 129.056, "end": 129.376, "text": "or"},
      {"start": 129.376, "end": 130.576, "text": "demonstrate"},
      {"start": 130.576, "end": 130.896, "text": "it"},
      {"start": 130.896, "end": 131.216, "text": "by"},
      {"start": 131.296, "end": 131.776, "text": "comparing"},
      {"start": 131.936, "end": 132.736, "text": "dissimilar"},
      {"start": 132.736, "end": 133.536, "text": "funds?"}
    ]},
    {"start": 134.416, "end": 136.016, "text": "I mean, that is one way.", "words": [
      {"start": 134.416, "end": 134.576, "text": "I"},
      {"start": 134.576, "end": 134.816, "text": "mean,"},
      {"start": 134.816, "end": 135.056, "text": "that"},
      {"start": 135.056, "end": 135.376, "text": "is"},
      {"start": 135.376, "end": 135.696, "text": "one"},
      {"start": 135.696, "end": 136.016, "text": "way."}
    ]},
    {"start": 136.384, "end": 137.024, "text": "That's a complaint.", "words": [
      {"start": 136.384, "end": 136.544, "text": "That's"},
      {"start": 136.544, "end": 136.704, "text": "a"},
      {"start": 136.704, "end": 137.024, "text": "complaint."}
    ]},
    {"start": 137.184, "end": 138.144, "text": "So, how would you do that?", "words": [
      {"start": 137.184, "end": 137.344, "text": "So,"},
