      {"start": 188.608, "end": 188.608, "text": "the"},
      {"start": 188.608, "end": 188.608, "text": "market."}
    ]},
    {"start": 188.768, "end": 205.008, "text": "I think what the Ninth Circuit is saying is you can't compare apples and orange if you have a fund, an equity fund, that is designed to produce high returns but riskier returns, and you can't compare that to a fund that.", "words": [
      {"start": 188.768, "end": 188.848, "text": "I"},
      {"start": 188.928, "end": 189.088, "text": "think"},
      {"start": 189.088, "end": 189.168, "text": "what"},
      {"start": 189.168, "end": 189.328, "text": "the"},
      {"start": 189.328, "end": 189.648, "text": "Ninth"},
      {"start": 189.648, "end": 190.048, "text": "Circuit"},
      {"start": 190.048, "end": 190.208, "text": "is"},
      {"start": 190.208, "end": 190.368, "text": "saying"},
      {"start": 190.368, "end": 190.528, "text": "is"},
      {"start": 190.608, "end": 190.768, "text": "you"},
      {"start": 190.768, "end": 191.008, "text": "can't"},
      {"start": 191.008, "end": 191.408, "text": "compare"},
      {"start": 191.408, "end": 191.888, "text": "apples"},
      {"start": 191.888, "end": 192.048, "text": "and"},
      {"start": 192.048, "end": 192.448, "text": "orange"},
