    ]},
    {"start": 138.464, "end": 138.864, "text": "Sure.", "words": [
      {"start": 138.464, "end": 138.864, "text": "Sure."}
    ]},
    {"start": 138.864, "end": 151.264, "text": "So, it's context-dependent, and there is no one specific fund that a complaint needs to identify to make performance allegations relevant to support a claim of imprudence.", "words": [
      {"start": 138.864, "end": 139.104, "text": "So,"},
      {"start": 139.104, "end": 139.504, "text": "it's"},
