    {"start": 22.081, "end": 27.241, "lines": ["of the statute isn't the whole statute,","the paradigmatic case isn't the only case."]},
    {"start": 27.664, "end": 31.104, "lines": ["Couldn't this case kind","of be the paradigmatic case?"]},
    {"start": 31.104, "end": 35.184, "lines": ["It's like you can watch lots","of embarrassing sports videos"]},
