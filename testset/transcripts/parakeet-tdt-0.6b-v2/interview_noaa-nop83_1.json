  "captions": [
    {"start": 0.401, "end": 4.641, "lines": ["We had to call","in our autonomous surface vessels"]},
    {"start": 4.641, "end": 7.841, "lines": ["from their homeboarded","in Gulfport, Mississippi."]},
    {"start": 7.841, "end": 9.281, "lines": ["We chose to mobilize them"]},
    {"start": 9.281, "end": 12.481, "lines": ["because they have drafts","of about 10 inches."]},
    {"start": 12.481, "end": 13.601, "lines": ["We have two of them."]},
    {"start": 13.601, "end": 17.201, "lines": ["They're about five foot long","and eight foot long."]},
    {"start": 17.201, "end": 20.401, "lines": ["Once they got on site,","we were able to use them"]},
    {"start": 20.401, "end": 24.241, "lines": ["to map the debris field to find all","of the hazards in the water."]},
    {"start": 24.241, "end": 25.721, "lines": ["So these are remote."]},
    {"start": 26.224, "end": 27.744, "lines": ["Operated vehicles."]},
    {"start": 27.744, "end": 29.904, "lines": ["Correct. Autonomous surface vehicles."]},
    {"start": 29.904, "end": 34.424, "lines": ["Autonomous meaning","you can program a preset mission,"]},
    {"start": 34.704, "end": 37.344, "lines": ["even give it a box and say,","go fill this area."]},
    {"start": 37.344, "end": 40.864, "lines": ["It'll go out and use","its hydrographic sensors,"]},
    {"start": 40.864, "end": 45.424, "lines": ["multi-beam sonars, side-scan sonars,","collect a full data set, come back"]},
    {"start": 45.424, "end": 49.504, "lines": ["to you, and you intercept it, process it,","and that we can use that data set"]},
    {"start": 49.504, "end": 51.504, "lines": ["to find all of the bits and pieces"]},
    {"start": 51.504, "end": 54.768, "lines": ["of the aircraft,","which was really critical for the FBI."]},
    {"start": 54.768, "end": 57.008, "lines": ["Divers uh that wanted to recover"]},
    {"start": 57.008, "end": 60.968, "lines": ["as much of the debris uh","from as possible from the waterway."]},
    {"start": 61.728, "end": 63.248, "lines": ["Oh, that's so interesting."]},
    {"start": 63.248, "end": 65.928, "lines": ["So these autonomous vehicles"]},
    {"start": 66.688, "end": 68.448, "lines": ["they're not remote controlled."]},
    {"start": 68.448, "end": 70.048, "lines": ["You program them"]},
    {"start": 70.048, "end": 74.048, "lines": ["and they go out and do their job","and come back and deliver the data."]},
