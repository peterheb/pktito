  "captions": [
    {"start": 0.161, "end": 3.441, "lines": ["Tanto la influenza o","gripe como el COVID-19 son"]},
    {"start": 3.441, "end": 9.041, "lines": ["enfermedades respiratorias contagiosas,","pero son provocadas por virus diferentes."]},
    {"start": 9.041, "end": 11.041, "lines": ["La causa del COVID-19 es una"]},
    {"start": 11.041, "end": 15.521, "lines": ["infección por un coronavirus que","se detectó por primera vez en 2019."]},
    {"start": 15.521, "end": 20.401, "lines": ["La influenza es provocada por la","infección por un virus de la influenza."]},
    {"start": 20.401, "end": 25.681, "lines": ["No es posible diferenciar la influenza","del COVID-19 solo observando los síntomas,"]},
    {"start": 25.681, "end": 30.272, "lines": ["porque algunos de los signos y síntomas","son iguales para las dos enfermedades."]},
    {"start": 30.272, "end": 34.912, "lines": ["Es necesario hacer pruebas de detección","específicas para saber de qué enfermedad"]},
    {"start": 34.912, "end": 37.472, "lines": ["se trata y confirmar un diagnóstico."]},
    {"start": 37.472, "end": 41.712, "lines": ["Si un profesional médico le hace una","prueba específica que permite detectar"]},
    {"start": 41.712, "end": 46.112, "lines": ["tanto la influenza como el COVID-19,","podrá tener el diagnóstico y recibir"]},
    {"start": 46.112, "end": 49.632, "lines": ["tratamiento para el virus","que tiene más rápidamente."]},
    {"start": 49.632, "end": 54.352, "lines": ["Tanto el COVID-19 como la influenza","pueden tener distintos grados de síntomas,"]},
    {"start": 54.352, "end": 58.64, "lines": ["los cuales van desde la ausencia","de síntomas a síntomas graves."]},
    {"start": 58.64, "end": 63.64, "lines": ["Los síntomas más comunes tanto del","COVID-19 como de la influenza incluyen"]},
    {"start": 64.16, "end": 66.8, "lines": ["fiebre o tener escalofríos."]},
    {"start": 66.8, "end": 72.56, "lines": ["TOS dificultad para respirar,","fatiga, dolor de garganta,"]},
    {"start": 72.56, "end": 77.84, "lines": ["mucosidad nasal o nariz tapada,","dolor muscular y molestias corporales,"]},
    {"start": 77.84, "end": 80.64, "lines": ["dolor de cabeza, vómitos."]},
    {"start": 80.64, "end": 83.68, "lines": ["Diarrea,","más frecuente en niños con influenza,"]},
    {"start": 83.68, "end": 87.269, "lines": ["pero puede ocurrir a cualquier","edad en personas con COVID-19."]},
    {"start": 87.408, "end": 90.528, "lines": ["y cambio o pérdida del gusto o el olfato,"]},
    {"start": 90.528, "end": 93.968, "lines": ["aunque esto es más","frecuente con el COVID-19."]},
    {"start": 93.968, "end": 97.248, "lines": ["En algunas personas,","el COVID-19 puede causar una"]},
    {"start": 97.248, "end": 99.568, "lines": ["enfermedad más grave que la influenza."]},
    {"start": 99.568, "end": 103.968, "lines": ["Los síntomas de las personas infectadas","con COVID-19 pueden tardar más en"]},
    {"start": 103.968, "end": 108.448, "lines": ["aparecer y pueden ser contagiosos por","periodos más prolongados en relación"]},
    {"start": 108.448, "end": 110.576, "lines": ["con las personas con influenza."]},
    {"start": 110.576, "end": 112.336, "lines": ["Las personas con mayor riesgo de"]},
    {"start": 112.336, "end": 116.576, "lines": ["presentar complicaciones o que fueron","hospitalizadas a causa del COVID-19"]},
    {"start": 116.576, "end": 120.336, "lines": ["o la influenza deben recibir los","tratamientos recomendados y la atención"]},
    {"start": 120.336, "end": 125.056, "lines": ["médica de apoyo para ayudar a aliviar","los síntomas y las complicaciones."]},
    {"start": 125.056, "end": 128.416, "lines": ["La mejor manera de reducir el","riesgo de la influenza estacional"]},
    {"start": 128.416, "end": 132.896, "lines": ["y sus complicaciones potencialmente","graves es vacunarse todos los años."]},
    {"start": 132.896, "end": 136.416, "lines": ["Pero los buenos hábitos de salud,","como evitar a las personas que están"]},
    {"start": 136.416, "end": 140.144, "lines": ["enfermas, cubrirse al toser y","lavarse las manos con frecuencia,"]},
    {"start": 140.144, "end": 143.984, "lines": ["Pueden ayudar a detener la propagación","de gérmenes y prevenir enfermedades"]},
    {"start": 143.984, "end": 146.624, "lines": ["respiratorias como la influenza."]},
    {"start": 146.624, "end": 151.424, "lines": ["Todas las vacunas contra el COVID-19","aprobadas o autorizadas en la actualidad"]},
    {"start": 151.424, "end": 156.224, "lines": ["son seguras y efectivas y reducen","su riesgo de enfermarse gravemente."]},
    {"start": 156.224, "end": 159.664, "lines": ["La vacunación puede reducir la","propagación de la enfermedad y ayudar"]},
    {"start": 159.664, "end": 163.888, "lines": ["a proteger a los que están vacunados","y a las personas que los rodean."]},
    {"start": 163.888, "end": 167.888, "lines": ["Los estudios realizados durante la","pandemia de COVID-19 indican que es"]},
    {"start": 167.888, "end": 173.488, "lines": ["seguro vacunarse contra la influenza y","contra el COVID-19 en la misma consulta."]},
    {"start": 173.488, "end": 176.928, "lines": ["La administración simultánea,","que consiste en recibir más de"]},
    {"start": 176.928, "end": 182.368, "lines": ["una vacuna en la misma consulta, es una","práctica médica común y es recomendable."]},
    {"start": 182.368, "end": 184.928, "lines": ["La idea es que las personas estén al día"]},
    {"start": 184.928, "end": 189.712, "lines": ["con todas las vacunas que les corresponden","y las reciban en la misma consulta."]},
    {"start": 189.712, "end": 193.072, "lines": ["Es una manera de asegurarse de","que las personas reciban todas las"]},
    {"start": 193.072, "end": 195.232, "lines": ["vacunas necesarias en caso de que no"]},
    {"start": 195.232, "end": 200.152, "lines": ["puedan regresar para recibir las demás","vacunas en otra consulta más adelante."]}
  ]
