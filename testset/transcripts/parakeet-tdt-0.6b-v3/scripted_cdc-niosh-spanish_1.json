  "captions": [
    {"start": 0.161, "end": 4.641, "lines": ["NIOS recomienda que los empleadores","usen pruebas de ajuste cuantitativas"]},
    {"start": 4.641, "end": 6.321, "lines": ["para evaluar la atenuación"]},
    {"start": 6.321, "end": 11.121, "lines": ["que proporcionan los dispositivos de","protección auditiva a los trabajadores."]},
    {"start": 11.121, "end": 16.081, "lines": ["Las pruebas de ajuste cuantitativas","son la medida física o psicofísica de"]},
    {"start": 16.081, "end": 21.201, "lines": ["la atenuación del ruido o el sonido","que proporciona un protector auditivo."]},
    {"start": 21.201, "end": 26.641, "lines": ["Las pruebas de ajuste dan lugar a","una puntuación personal de atenuación."]},
    {"start": 26.641, "end": 28.681, "lines": ["FAR, por sus siglas en inglés."]},
    {"start": 29.008, "end": 30.848, "lines": ["That is objective and refleja con"]},
    {"start": 30.848, "end": 35.201, "lines": ["precisión el nivel de reducción del","sonido that obtiene a trabajador when…"]},
    {"start": 36.128, "end": 39.368, "lines": ["they are auditivo specific,","or indicate that a person"]},
    {"start": 39.648, "end": 43.408, "lines": ["has alcanzado a nivel de protección","específicamente."]},
    {"start": 43.408, "end": 47.248, "lines": ["The empleadores deben integrar","las pruebas de ajuste individual"]},
    {"start": 47.248, "end": 50.808, "lines": ["to the programs of prevention","of the pérdida auditive."]},
    {"start": 51.088, "end": 52.88, "lines": ["In the document of Nayos,"]},
    {"start": 52.88, "end": 58.72, "lines": ["Criterios para un estándar recomendado,","exposición al ruido ocupacional de 1998,"]},
    {"start": 58.72, "end": 63.68, "lines": ["Nyosh estableció que, idealmente,","se deben hacer pruebas de ajuste"]},
    {"start": 63.68, "end": 68, "lines": ["individuales a los trabajadores","para los protectores auditivos."]},
    {"start": 68, "end": 70.8, "lines": ["Sin embargo, en 1998,"]},
    {"start": 70.8, "end": 75.136, "lines": ["los sistemas de pruebas de ajuste","no estaban disponibles comercialmente."]},
    {"start": 75.136, "end": 77.936, "lines": ["Por lo tanto, NIS recomendó en su lugar"]},
    {"start": 77.936, "end": 82.896, "lines": ["reducir la clasificación de reducción","del ruido en la etiqueta del fabricante"]},
    {"start": 82.896, "end": 88.736, "lines": ["para estimar la atención del protector","auditivo de un trabajador según su uso."]},
    {"start": 88.736, "end": 94.896, "lines": ["Desde 1998, los avances en investigación","y tecnología han hecho posible"]},
    {"start": 94.896, "end": 99.216, "lines": ["comprobar rápidamente la atenuación","que obtiene cada trabajador de sus"]},
    {"start": 99.216, "end": 103.576, "lines": ["dispositivos de protección auditiva","preferidos in el lugar de trabajo."]},
    {"start": 103.904, "end": 105.504, "lines": ["Ahora hay disponibles"]},
    {"start": 105.504, "end": 109.424, "lines": ["varios sistemas de pruebas de","ajuste de protectores auditivos."]},
    {"start": 109.424, "end": 115.184, "lines": ["Hay una norma disponible de la Sociedad","de Acústica de América y el Instituto"]},
    {"start": 115.184, "end": 121.104, "lines": ["Estadounidense de Estándares Nacionales,","ASA ANSI, que especifica los"]},
    {"start": 121.104, "end": 126.464, "lines": ["criterios de rendimiento para el equipo","y un método para calcular una par."]},
    {"start": 126.464, "end": 129.144, "lines": ["Durante décadas, NIOS ha desarrollado"]},
    {"start": 129.472, "end": 131.872, "lines": ["Investigado y propiciado avances en la"]},
    {"start": 131.872, "end": 135.552, "lines": ["tecnología de pruebas de ajuste","de los protectores auditivos."]},
    {"start": 135.552, "end": 139.312, "lines": ["Las investigaciones de NIOS demostraron","que las clasificaciones de los"]},
    {"start": 139.312, "end": 144.112, "lines": ["protectores auditivos basadas en pruebas","de laboratorio sobreestiman la protección"]},
    {"start": 144.112, "end": 147.952, "lines": ["de los trabajadores en el campo,","que las estrategias de reducción de la"]},
    {"start": 147.952, "end": 152.752, "lines": ["clasificación de los protectores auditivos","no pueden evaluar el ajuste adecuado y"]},
    {"start": 152.752, "end": 155.44, "lines": ["que la capacitación individualizada."]},
    {"start": 155.44, "end": 158.8, "lines": ["Es necesaria para que las pruebas","de ajuste mejoren la atención que"]},
    {"start": 158.8, "end": 160.72, "lines": ["obtienen los trabajadores."]},
    {"start": 160.72, "end": 163.04, "lines": ["Por lo tanto, NIOS recomienda las"]},
    {"start": 163.04, "end": 167.36, "lines": ["pruebas de ajuste cuantitativas","individuales de los protectores"]},
    {"start": 167.36, "end": 172.8, "lines": ["auditivos en lugar de la estrategia","de reducción de la clasificación."]},
    {"start": 172.8, "end": 177.52, "lines": ["Las pruebas de ajuste de los protectores","auditivos proporcionan un valor personal"]},
    {"start": 177.52, "end": 183.072, "lines": ["de reducción de ruido para cada trabajador","que use un determinado protector auditivo."]},
    {"start": 183.072, "end": 187.632, "lines": ["Esta declaración de política aclara que","Nyosh recomienda las pruebas de ajuste"]},
    {"start": 187.632, "end": 192.432, "lines": ["de los protectores auditivos como","práctica esencial para garantizar que los"]},
    {"start": 192.432, "end": 197.992, "lines": ["dispositivos de protección auditiva se","ajusten adecuadamente a cada trabajador."]}
  ]
}
