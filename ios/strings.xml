<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS app's own words, beside Android's (android/app/src/main/res/values/strings.xml), which scripts/strings-ios.py makes the iOS catalog from first: what only iOS says. Each is written as an Android string resource would be. -->
<resources>
    <!-- the setup screen while Core ML compiles the Neural Engine's encoder, the first time after an install or an update; %1$s is the device's kind, "iPhone" or "iPad" -->
    <string name="prepare_title">Preparing pktito for this %1$s…</string>
    <string name="prepare_why">Compiling the speech model for the Neural Engine.</string>
    <!-- a toast, where the Neural Engine couldn't run the model and the whole model file is downloaded instead -->
    <string name="prepare_cpu">This %1$s\'s Neural Engine can\'t run the model, so pktito uses its processor instead</string>
    <!-- the strip, where the recording found doesn't play (Android's play_cant names Android) -->
    <string name="play_cant_ios">iOS can\'t play this file</string>
    <!-- the play button's spoken name while iOS reads through the recording, so that a time sought to is exactly that time (a long FLAC can take a few seconds) -->
    <string name="play_preparing">Getting the recording ready to play</string>
    <!-- About's credits, what "Everything else" covers (Android's about_else_list names Jetpack Compose) -->
    <string name="about_else_list_ios">SwiftUI, Rust crates, typefaces, icons, etc.</string>
    <!-- the licenses' heading over the libraries (Android's notices_libraries says Android) -->
    <string name="notices_libraries_ios">Libraries</string>
    <!-- Privacy, Your choices (Android's privacy_choice_uninstall says uninstalling): what deleting the app deletes from the iPhone or iPad; what iOS keeps in its own backups is iOS's to say -->
    <string name="privacy_choice_uninstall_ios">Deleting pktito deletes its settings, its models and its recent transcripts from this device.</string>
</resources>
