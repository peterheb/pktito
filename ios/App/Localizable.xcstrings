    "privacy_choice_uninstall_ios": {
      "extractionState": "manual",
      "comment": "Privacy, Your choices (Android's privacy_choice_uninstall says uninstalling): what deleting the app deletes from the iPhone or iPad; what iOS keeps in its own backups is iOS's to say",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
