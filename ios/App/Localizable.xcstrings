    "privacy_choices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices"
          }
        }
      }
    },
    "privacy_download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Downloading a model.** pktito downloads AI models from models.pktito.net, hosted on a content delivery network. The server logs your IP address, the time, the file requested and a standard user-agent string, but no name, account or device identifier. These logs are used to keep the service secure and to count downloads in aggregate. We don't use them to identify you, combine them with other data, or sell or share them."
          }
        }
      }
    },
    "privacy_files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files"
          }
        }
      }
    },
    "privacy_files_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pktito opens only the recordings you choose, open with it or share to it, and saves only where you choose. It asks for no access to your storage. A transcript you share goes to the app you pick."
          }
        }
      }
    },
    "privacy_internet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What reaches the internet"
          }
        }
      }
    },
    "privacy_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pktito is local transcription software — it turns speech into text on this device. Your media files are not uploaded to cloud servers, and pktito has no accounts, ads or tracking."
          }
        }
      }
    },
    "privacy_links": {
      "extractionState": "manual",
      "localizations": {
        "en": {
